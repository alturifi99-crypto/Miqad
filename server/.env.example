# Documentation only. For local development run: node scripts/dev-db.mjs
# Never commit real values, use these placeholders, or use the admin role at runtime.
DATABASE_ADMIN_URL=postgresql://postgres:REPLACE_ADMIN_PASSWORD@127.0.0.1:15432/miqad
DATABASE_URL=postgresql://miqad_app:REPLACE_APP_PASSWORD@127.0.0.1:15432/miqad
AUTH_DATABASE_URL=postgresql://miqad_auth:REPLACE_AUTH_PASSWORD@127.0.0.1:15432/miqad
PLATFORM_DATABASE_URL=postgresql://miqad_platform:REPLACE_PLATFORM_PASSWORD@127.0.0.1:15432/miqad
PUBLIC_ORIGIN=http://127.0.0.1:8090
PORT=8090
NODE_ENV=development
# Optional local secure-account mode; never enables production by itself.
# AUTH_SECURITY=enabled
# AUTH_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS
# MAIL_PROVIDER=resend
# MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
# MAIL_API_KEY=REPLACE_IN_SECRET_SETTINGS_ONLY
